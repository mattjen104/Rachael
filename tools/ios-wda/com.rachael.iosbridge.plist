<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.rachael.iosbridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/USERNAME/src/rachael/tools/.venv/bin/python</string>
    <string>/Users/USERNAME/src/rachael/tools/ios_wda_bridge.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>/Users/USERNAME/src/rachael/tools</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>/tmp/rachael-iosbridge.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/rachael-iosbridge.err.log</string>
</dict>
</plist>
